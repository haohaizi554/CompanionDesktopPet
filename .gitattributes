# Preserve immutable legacy inputs byte-for-byte while keeping textual diffs.
/data/source/persona-corpus.original.tsv -text diff whitespace=cr-at-eol
/src/CompanionDesktopPet/Assets/persona-corpus.tsv -text diff whitespace=cr-at-eol

# Generated and intermediate TSVs are deterministic LF artifacts.
/data/intermediate/*.tsv text eol=lf
/data/optimized/*.tsv text eol=lf
/reports/*.tsv text eol=lf
/reports/*.md text eol=lf
/reports/*.json text eol=lf

# Provenance hashes bind these JSON files byte-for-byte across platforms.
/config/*.json text eol=lf
/config/schemas/*.json text eol=lf

# Keep the byte-exact standard license and companion rights notices stable on
# Windows runners so the CI license hash cannot drift through CRLF checkout.
/LICENSE text eol=lf
/NOTICE text eol=lf
/LICENSE-SCOPE.md text eol=lf
/ASSET_AND_PERSONA_RIGHTS.md text eol=lf
