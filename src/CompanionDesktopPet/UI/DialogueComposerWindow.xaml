<Window x:Class="CompanionDesktopPet.UI.DialogueComposerWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="和佳怡说"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        ShowActivated="False"
        Topmost="True"
        FontFamily="{DynamicResource Pet.FontFamily.Ui}"
        Foreground="{DynamicResource Pet.Brush.TextPrimary}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
  <Grid x:Name="Surface" Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="12" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="12" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="12" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="12" />
    </Grid.ColumnDefinitions>
    <Path x:Name="ArrowUp"
          Grid.Row="0"
          Grid.Column="1"
          Width="20"
          Height="12"
          HorizontalAlignment="Center"
          Visibility="Collapsed"
          Fill="{DynamicResource Pet.Brush.BubbleArrow}"
          Stroke="{DynamicResource Pet.Brush.AccentBorder}"
          StrokeThickness="2"
          Data="M 0,12 L 20,12 L 10,0 Z" />
    <Path x:Name="ArrowLeft"
          Grid.Row="1"
          Grid.Column="0"
          Width="12"
          Height="18"
          VerticalAlignment="Center"
          Visibility="Collapsed"
          Fill="{DynamicResource Pet.Brush.BubbleArrow}"
          Stroke="{DynamicResource Pet.Brush.AccentBorder}"
          StrokeThickness="2"
          Data="M 12,0 L 12,18 L 0,9 Z" />
    <Border Grid.Row="1"
            Grid.Column="1"
            Width="276"
            Padding="10,8"
            CornerRadius="25"
            Background="{DynamicResource Pet.Brush.BubbleSurface}"
            BorderBrush="{DynamicResource Pet.Brush.AccentBorder}"
            BorderThickness="2">
      <Border.Effect>
        <DropShadowEffect Color="{DynamicResource Pet.Color.Shadow.Bubble}"
                          BlurRadius="14"
                          ShadowDepth="3"
                          Opacity="{DynamicResource Pet.Opacity.Shadow.Bubble}" />
      </Border.Effect>
      <DockPanel LastChildFill="True">
        <Button DockPanel.Dock="Right"
                Margin="8,0,0,0"
                MinWidth="64"
                MinHeight="34"
                Padding="12,6"
                Content="发送"
                Style="{StaticResource KawaiiPrimaryButtonStyle}"
                Click="Send_Click" />
        <Grid MinHeight="34">
          <TextBox x:Name="Input"
                   MinHeight="34"
                   FontSize="14"
                   Style="{StaticResource KawaiiTextBoxStyle}"
                   PreviewKeyDown="Input_PreviewKeyDown"
                   TextChanged="Input_TextChanged">
            <TextBox.ContextMenu>
              <ContextMenu Style="{StaticResource KawaiiContextMenuStyle}"
                           Opened="InputMenu_Opened">
                <ContextMenu.Resources>
                  <Style TargetType="MenuItem" BasedOn="{StaticResource KawaiiMenuItemStyle}" />
                </ContextMenu.Resources>
                <MenuItem x:Name="CutItem"
                          Header="剪切"
                          Tag="✂"
                          Command="ApplicationCommands.Cut"
                          CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                <MenuItem x:Name="CopyItem"
                          Header="复制"
                          Tag="⧉"
                          Command="ApplicationCommands.Copy"
                          CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                <MenuItem x:Name="PasteItem"
                          Header="粘贴"
                          Tag="⎘"
                          Command="ApplicationCommands.Paste"
                          CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
              </ContextMenu>
            </TextBox.ContextMenu>
          </TextBox>
          <TextBlock x:Name="Hint"
                     Margin="14,0,8,0"
                     IsHitTestVisible="False"
                     VerticalAlignment="Center"
                     FontSize="14"
                     Foreground="{DynamicResource Pet.Brush.TextDisabled}"
                     Text="跟佳怡说一句" />
        </Grid>
      </DockPanel>
    </Border>
    <Path x:Name="ArrowRight"
          Grid.Row="1"
          Grid.Column="2"
          Width="12"
          Height="18"
          VerticalAlignment="Center"
          Visibility="Collapsed"
          Fill="{DynamicResource Pet.Brush.BubbleArrow}"
          Stroke="{DynamicResource Pet.Brush.AccentBorder}"
          StrokeThickness="2"
          Data="M 0,0 L 0,18 L 12,9 Z" />
    <Path x:Name="ArrowDown"
          Grid.Row="2"
          Grid.Column="1"
          Width="20"
          Height="12"
          HorizontalAlignment="Center"
          Visibility="Collapsed"
          Fill="{DynamicResource Pet.Brush.BubbleArrow}"
          Stroke="{DynamicResource Pet.Brush.AccentBorder}"
          StrokeThickness="2"
          Data="M 0,0 L 20,0 L 10,12 Z" />
  </Grid>
</Window>
