<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>CompanionDesktopPet</AssemblyName>
    <RootNamespace>CompanionDesktopPet</RootNamespace>
    <ApplicationIcon>Assets\pet.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\character.png;Assets\pet.ico" />
    <Resource Include="Assets\character.png;Assets\pet.ico" />
    <EmbeddedResource Include="../../data/optimized/persona-corpus-v2.tsv"
                      LogicalName="CompanionDesktopPet.Assets.persona-corpus-v2.tsv" />
    <Compile Remove="Services/PersonaCorpus.EasterEggs.cs;Services/PersonaCorpus.Growth.cs;Services/PersonaCorpus.Life.cs;Services/PersonaCorpus.Technical.cs" />
  </ItemGroup>

</Project>
