<Window x:Class="CompanionDesktopPet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:CompanionDesktopPet.UI"
        Title="角色桌宠"
        Width="420"
        Height="520"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        AutomationProperties.Name="佳怡桌宠">
  <Window.Resources>
    <Style x:Key="ParameterNameText" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource Pet.FontFamily.Ui}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Pet.Brush.TextPrimary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="ParameterValueBadge" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Pet.Brush.PanelSelected}" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="MinWidth" Value="118" />
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="ParameterValueText" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource Pet.FontFamily.Ui}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource Pet.Brush.TextDisabled}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="TextAlignment" Value="Center" />
    </Style>
  </Window.Resources>
  <Grid x:Name="InteractionSurface">
    <Popup x:Name="BubblePopup"
           AllowsTransparency="True"
           Focusable="False"
           Placement="AbsolutePoint"
           StaysOpen="True">
      <Border x:Name="BubblePopupSurface"
              Padding="10"
              Background="Transparent">
        <StackPanel x:Name="SpeechBubble"
                    Width="276"
                    Visibility="Collapsed">
          <Path x:Name="BubbleArrowUp"
                Width="20"
                Height="12"
                HorizontalAlignment="Left"
                Fill="{DynamicResource Pet.Brush.BubbleArrow}"
                Stroke="{DynamicResource Pet.Brush.AccentBorder}"
                StrokeThickness="2"
                Visibility="Collapsed"
                Data="M 0,12 L 20,12 L 10,0 Z" />
            <Border Padding="18,13"
                  CornerRadius="25"
                  Background="{DynamicResource Pet.Brush.BubbleSurface}"
                  BorderBrush="{DynamicResource Pet.Brush.AccentBorder}"
                  BorderThickness="2">
            <Border.Effect>
              <DropShadowEffect Color="{DynamicResource Pet.Color.Shadow.Bubble}"
                                BlurRadius="14"
                                ShadowDepth="3"
                                Opacity="{DynamicResource Pet.Opacity.Shadow.Bubble}" />
            </Border.Effect>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid x:Name="VoiceProgressRing"
                    Width="34"
                    Height="34"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    Visibility="Collapsed"
                    IsHitTestVisible="False">
                <Ellipse Stroke="{DynamicResource Pet.Brush.AccentBorder}"
                         StrokeThickness="3"
                         Opacity="0.28" />
                <Ellipse x:Name="VoiceProgressArc"
                         Stroke="{DynamicResource Pet.Brush.AccentBorder}"
                         StrokeThickness="3"
                         StrokeStartLineCap="Round"
                         StrokeEndLineCap="Round"
                         RenderTransformOrigin="0.5,0.5">
                  <Ellipse.RenderTransform>
                    <RotateTransform x:Name="VoiceProgressRotate" Angle="-90" />
                  </Ellipse.RenderTransform>
                </Ellipse>
              </Grid>
              <ScrollViewer Grid.Column="1"
                            MaxHeight="240"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="SpeechText"
                           Foreground="{DynamicResource Pet.Brush.TextPrimary}"
                           FontFamily="{StaticResource Pet.FontFamily.Ui}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           VerticalAlignment="Center"
                           AutomationProperties.LiveSetting="Polite" />
              </ScrollViewer>
            </Grid>
          </Border>
          <Path x:Name="BubbleArrowDown"
                Width="20"
                Height="12"
                HorizontalAlignment="Left"
                Fill="{DynamicResource Pet.Brush.BubbleArrow}"
                Stroke="{DynamicResource Pet.Brush.AccentBorder}"
                StrokeThickness="2"
                Data="M 0,0 L 20,0 L 10,12 Z" />
        </StackPanel>
      </Border>
    </Popup>

    <Grid x:Name="CharacterStage"
            Width="320"
            Height="320"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Background="Transparent"
            RenderTransformOrigin="0.5,0.92"
            Focusable="True"
            ContextMenuService.Placement="Custom"
            AutomationProperties.Name="佳怡"
            AutomationProperties.HelpText="右键或按菜单键打开控制面板；拖动佳怡可以移动位置。">
      <Grid.RenderTransform>
        <TransformGroup>
          <ScaleTransform x:Name="BreathingScale" ScaleX="1" ScaleY="1" />
          <ScaleTransform x:Name="ReactionScale" ScaleX="1" ScaleY="1" />
          <RotateTransform x:Name="SwayRotation" Angle="0" />
          <RotateTransform x:Name="ReactionRotation" Angle="0" />
          <TranslateTransform x:Name="FloatingOffset" Y="0" />
          <ScaleTransform x:Name="ActionScale" ScaleX="1" ScaleY="1" />
          <RotateTransform x:Name="ActionRotation" Angle="0" />
          <TranslateTransform x:Name="ActionOffset" X="0" Y="0" />
        </TransformGroup>
      </Grid.RenderTransform>
      <Grid.ContextMenu>
        <ContextMenu x:Name="ControlMenu"
                     Style="{StaticResource KawaiiContextMenuStyle}"
                     AutomationProperties.Name="佳怡控制面板">
          <ContextMenu.Resources>
            <Style TargetType="MenuItem"
                   BasedOn="{StaticResource KawaiiMenuItemStyle}" />
            <Style TargetType="Separator"
                   BasedOn="{StaticResource KawaiiSeparatorStyle}" />
            <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}"
                   TargetType="Separator"
                   BasedOn="{StaticResource KawaiiSeparatorStyle}" />
          </ContextMenu.Resources>
          <MenuItem x:Name="SayMenuItem"
                    Header="说句话 ♡"
                    Tag="✦"
                    AutomationProperties.HelpText="让佳怡说一句话。" />
          <MenuItem x:Name="VoiceMenuItem"
                    Header="语音开关"
                    Tag="♪"
                    IsCheckable="True"
                    IsChecked="False"
                    IsEnabled="False"
                    AutomationProperties.HelpText="打开后佳怡会把这句话念出来。句子会留到声音结束。点她时，先说你点的这句，正在合成的那句不会被打断。" />
          <MenuItem x:Name="DialogueMenuItem"
                    Header="对话开关"
                    Tag="✎"
                    IsCheckable="True"
                    IsChecked="False"
                    AutomationProperties.HelpText="默认关闭。第一次打开会请你填写对话接口。模型可以在这台电脑、另一台 Windows、Linux 或 macOS 上，也可以直接用第三方接口。语音仍在本机合成。" />
          <MenuItem x:Name="DialogueEndpointMenuItem"
                    Header="填写对话接口"
                    Tag="✎"
                    AutomationProperties.HelpText="填写本地或第三方的 OpenAI 兼容接口。地址支持 127.0.0.1、局域网和 https。" />
          <MenuItem x:Name="GreetingMenuItem" Header="打个招呼♡" Tag="♡" />
          <MenuItem x:Name="PauseMenuItem" Header="暂停动画" Tag="☾" />
          <Separator />
          <MenuItem x:Name="SizeMenuItem" Header="大小" Tag="◌">
            <MenuItem x:Name="SmallSizeMenuItem" Header="小巧" Tag="Small" IsCheckable="True" />
            <MenuItem x:Name="NormalSizeMenuItem" Header="刚刚好" Tag="Normal" IsCheckable="True" IsChecked="True" />
            <MenuItem x:Name="LargeSizeMenuItem" Header="大一点" Tag="Large" IsCheckable="True" />
          </MenuItem>
          <MenuItem x:Name="TopmostMenuItem"
                    Header="保持置顶"
                    Tag="⌁"
                    IsCheckable="True"
                    IsChecked="True" />
          <MenuItem x:Name="AutoStartMenuItem"
                    Header="开机自启动"
                    Tag="⌁"
                    IsCheckable="True"
                    ToolTipService.ShowOnDisabled="True" />
          <MenuItem x:Name="RestorePositionMenuItem" Header="回到右下角" Tag="⌂" />
          <Separator />
          <MenuItem x:Name="DeveloperModeMenuItem"
                    Header="开发者模式"
                    Tag="⚙"
                    Style="{StaticResource KawaiiDeveloperMenuStyle}"
                    SubmenuOpened="DeveloperModeMenu_SubmenuOpened"
                    AutomationProperties.HelpText="打开语料库和语音库，或从测试参数再进一层改这一次的间隔。">
            <MenuItem.Resources>
              <Style TargetType="ScrollBar" BasedOn="{StaticResource KawaiiScrollBarStyle}" />
            </MenuItem.Resources>
            <MenuItem x:Name="CorpusMenuItem"
                      Header="语料库"
                      Tag="☰"
                      AutomationProperties.HelpText="按分类组和分类查看全部语句。">
              <MenuItem x:Name="BrowseAllCorpusMenuItem"
                        Header="全库语句…"
                        Tag="☰" />
            </MenuItem>
            <MenuItem x:Name="VoiceLibraryMenuItem"
                      Header="语音库"
                      Tag="♪"
                      AutomationProperties.HelpText="查看参考原声和对应原文，点一条就能听这段录音。">
              <MenuItem x:Name="BrowseVoiceLibraryMenuItem"
                        Header="全部参考…"
                        Tag="♪" />
            </MenuItem>
            <MenuItem x:Name="TestParametersMenuItem"
                      Header="测试参数"
                      Tag="⌁"
                      Style="{StaticResource KawaiiDeveloperMenuStyle}"
                      SubmenuOpened="DeveloperModeMenu_SubmenuOpened"
                      AutomationProperties.HelpText="再展开一层，手改自动台词间隔、气泡停留和一次最多说多少字。语音开着时还能改语速和语气。">
              <MenuItem Style="{StaticResource KawaiiMenuPanelStyle}" StaysOpenOnClick="True">
                <MenuItem.Header>
                <StackPanel Width="356" Margin="4,2,4,6">
                  <TextBlock Margin="0,2,0,8"
                             FontSize="11"
                             FontFamily="{DynamicResource Pet.FontFamily.Ui}"
                             TextWrapping="Wrap"
                             Foreground="{DynamicResource Pet.Brush.TextDisabled}"
                             Text="只改这一次，不会动语料本。拖动停在可用范围内。" />
                  <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="48" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="126" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource ParameterNameText}" Text="白天" />
                    <ui:RangeSlider x:Name="DayRange" Grid.Column="1" RangeChanged="DeveloperRange_Changed" AutomationProperties.Name="白天间隔" />
                    <Border Grid.Column="2" Style="{StaticResource ParameterValueBadge}">
                      <TextBlock x:Name="DayRangeText" Style="{StaticResource ParameterValueText}" />
                    </Border>
                  </Grid>
                  <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="48" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="126" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource ParameterNameText}" Text="傍晚" />
                    <ui:RangeSlider x:Name="EveningRange" Grid.Column="1" RangeChanged="DeveloperRange_Changed" AutomationProperties.Name="傍晚间隔" />
                    <Border Grid.Column="2" Style="{StaticResource ParameterValueBadge}">
                      <TextBlock x:Name="EveningRangeText" Style="{StaticResource ParameterValueText}" />
                    </Border>
                  </Grid>
                  <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="48" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="126" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource ParameterNameText}" Text="深夜" />
                    <ui:RangeSlider x:Name="LateRange" Grid.Column="1" RangeChanged="DeveloperRange_Changed" AutomationProperties.Name="深夜间隔" />
                    <Border Grid.Column="2" Style="{StaticResource ParameterValueBadge}">
                      <TextBlock x:Name="LateRangeText" Style="{StaticResource ParameterValueText}" />
                    </Border>
                  </Grid>
                  <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="48" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="126" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource ParameterNameText}" Text="全屏" />
                    <ui:RangeSlider x:Name="FullscreenRange" Grid.Column="1" RangeChanged="DeveloperRange_Changed" AutomationProperties.Name="全屏间隔" />
                    <Border Grid.Column="2" Style="{StaticResource ParameterValueBadge}">
                      <TextBlock x:Name="FullscreenRangeText" Style="{StaticResource ParameterValueText}" />
                    </Border>
                  </Grid>
                  <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="48" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="126" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource ParameterNameText}" Text="气泡" />
                    <ui:RangeSlider x:Name="BubbleSlider" Grid.Column="1" IsRange="False" RangeChanged="DeveloperRange_Changed" AutomationProperties.Name="气泡停留秒数" />
                    <Border Grid.Column="2" Style="{StaticResource ParameterValueBadge}">
                      <TextBlock x:Name="BubbleValueText" Style="{StaticResource ParameterValueText}" />
                    </Border>
                  </Grid>
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="48" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="126" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource ParameterNameText}" Text="输出" />
                    <ui:RangeSlider x:Name="ReplyMaxCharsSlider" Grid.Column="1" IsRange="False" RangeChanged="DeveloperRange_Changed" AutomationProperties.Name="一次最多输出字数" />
                    <Border Grid.Column="2" Style="{StaticResource ParameterValueBadge}">
                      <TextBlock x:Name="ReplyValueText" Style="{StaticResource ParameterValueText}" />
                    </Border>
                  </Grid>
                  <StackPanel x:Name="VoiceParameterPanel" Visibility="Collapsed">
                    <TextBlock Margin="0,2,0,8"
                               FontSize="11"
                               FontFamily="{DynamicResource Pet.FontFamily.Ui}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Pet.Brush.TextDisabled}"
                               Text="语音开着。语速 1 是原速，语气越高越活，重复越高越少绕。下一句生效。" />
                    <Grid Margin="0,0,0,6">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="126" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Style="{StaticResource ParameterNameText}" Text="语速" />
                      <ui:RangeSlider x:Name="SpeechSpeedSlider" Grid.Column="1" IsRange="False" RangeChanged="DeveloperRange_Changed" AutomationProperties.Name="语速" />
                      <Border Grid.Column="2" Style="{StaticResource ParameterValueBadge}">
                        <TextBlock x:Name="SpeechSpeedValueText" Style="{StaticResource ParameterValueText}" />
                      </Border>
                    </Grid>
                    <Grid Margin="0,0,0,6">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="126" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Style="{StaticResource ParameterNameText}" Text="语气" />
                      <ui:RangeSlider x:Name="SpeechTemperatureSlider" Grid.Column="1" IsRange="False" RangeChanged="DeveloperRange_Changed" AutomationProperties.Name="语气" />
                      <Border Grid.Column="2" Style="{StaticResource ParameterValueBadge}">
                        <TextBlock x:Name="SpeechTemperatureValueText" Style="{StaticResource ParameterValueText}" />
                      </Border>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="126" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Style="{StaticResource ParameterNameText}" Text="重复" />
                      <ui:RangeSlider x:Name="SpeechRepetitionSlider" Grid.Column="1" IsRange="False" RangeChanged="DeveloperRange_Changed" AutomationProperties.Name="重复" />
                      <Border Grid.Column="2" Style="{StaticResource ParameterValueBadge}">
                        <TextBlock x:Name="SpeechRepetitionValueText" Style="{StaticResource ParameterValueText}" />
                      </Border>
                    </Grid>
                  </StackPanel>
                  <TextBlock x:Name="ParameterErrorText"
                             Margin="0,0,0,6"
                             FontSize="11"
                             TextWrapping="Wrap"
                             Foreground="#FFBE4B70" />
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="8" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ApplyParametersButton"
                            MinHeight="28"
                            Padding="6,4"
                            FontSize="12"
                            Style="{StaticResource KawaiiPrimaryButtonStyle}"
                            Content="就用这组"
                            Click="ApplyParameters_Click" />
                    <Button x:Name="ResetParametersButton"
                            Grid.Column="2"
                            MinHeight="28"
                            Padding="6,4"
                            FontSize="12"
                            Style="{StaticResource KawaiiSecondaryButtonStyle}"
                            Content="恢复默认"
                            Click="ResetParameters_Click" />
                  </Grid>
                  <TextBlock x:Name="ParameterStatusText"
                             Margin="0,6,0,0"
                             FontSize="11"
                             TextWrapping="Wrap"
                             Foreground="{DynamicResource Pet.Brush.TextDisabled}" />
                </StackPanel>
                </MenuItem.Header>
              </MenuItem>
            </MenuItem>
          </MenuItem>
          <Separator />
          <MenuItem x:Name="HideToTrayMenuItem"
                    Header="藏到托盘里 ♡"
                    Tag="☾"
                    ToolTipService.ShowOnDisabled="True" />
          <MenuItem x:Name="ExitMenuItem" Header="先休息啦（退出）" Tag="☁" />
        </ContextMenu>
      </Grid.ContextMenu>

      <Viewbox Stretch="Uniform">
        <Grid Width="320" Height="320">
      <Image x:Name="PetImage"
             Source="pack://application:,,,/CompanionDesktopPet;component/Assets/character.png"
             Stretch="Uniform" />

      <Image x:Name="BlinkOverlay"
             Source="pack://application:,,,/CompanionDesktopPet;component/Assets/character-blink-closed.png"
             Stretch="Uniform"
             Opacity="0"
             IsHitTestVisible="False" />

      <Image x:Name="MouthMid"
             Source="pack://application:,,,/CompanionDesktopPet;component/Assets/mouth-mid.png"
             Stretch="Uniform"
             Opacity="0"
             IsHitTestVisible="False" />

      <Image x:Name="MouthOpen"
             Source="pack://application:,,,/CompanionDesktopPet;component/Assets/mouth-open.png"
             Stretch="Uniform"
             Opacity="0"
             IsHitTestVisible="False" />

      <Border x:Name="GreetingBadge"
              Margin="0,56,48,0"
              Padding="12,7"
              HorizontalAlignment="Right"
              VerticalAlignment="Top"
               Background="{DynamicResource Pet.Brush.BubbleSurface}"
               BorderBrush="{DynamicResource Pet.Brush.AccentBorder}"
              BorderThickness="2"
              CornerRadius="18"
              Opacity="0"
              IsHitTestVisible="False">
        <Border.RenderTransform>
          <TranslateTransform x:Name="GreetingBadgeOffset" Y="8" />
        </Border.RenderTransform>
        <TextBlock Text="嗨♡"
                   Foreground="{DynamicResource Pet.Brush.TextPrimary}"
                   FontFamily="{StaticResource Pet.FontFamily.Ui}"
                   FontSize="16"
                   FontWeight="SemiBold" />
      </Border>

      <Canvas x:Name="HeartLayer"
              Width="320"
              Height="320"
              IsHitTestVisible="False">
        <TextBlock x:Name="HeartOne"
                   Canvas.Left="229"
                   Canvas.Top="124"
                   Text="♥"
                   Foreground="{DynamicResource Pet.Brush.HeartPrimary}"
                   FontSize="25"
                   FontWeight="Bold"
                   Opacity="0"
                   RenderTransformOrigin="0.5,0.5">
          <TextBlock.RenderTransform>
            <TranslateTransform />
          </TextBlock.RenderTransform>
        </TextBlock>
        <TextBlock x:Name="HeartTwo"
                   Canvas.Left="257"
                   Canvas.Top="159"
                   Text="♥"
                   Foreground="{DynamicResource Pet.Brush.HeartSecondary}"
                   FontSize="20"
                   FontWeight="Bold"
                   Opacity="0"
                   RenderTransformOrigin="0.5,0.5">
          <TextBlock.RenderTransform>
            <TranslateTransform />
          </TextBlock.RenderTransform>
        </TextBlock>
        <TextBlock x:Name="HeartThree"
                   Canvas.Left="214"
                   Canvas.Top="184"
                   Text="♥"
                   Foreground="{DynamicResource Pet.Brush.HeartTertiary}"
                   FontSize="17"
                   FontWeight="Bold"
                   Opacity="0"
                   RenderTransformOrigin="0.5,0.5">
          <TextBlock.RenderTransform>
            <TranslateTransform />
          </TextBlock.RenderTransform>
        </TextBlock>
      </Canvas>
        </Grid>
      </Viewbox>
    </Grid>
  </Grid>
</Window>
