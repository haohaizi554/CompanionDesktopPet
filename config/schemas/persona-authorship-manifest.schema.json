{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://companiondesktop.pet/schemas/persona-authorship-manifest.schema.json",
  "title": "Companion Desktop Pet authored corpus provenance manifest",
  "type": "object",
  "required": [
    "$schema",
    "schema_version",
    "format",
    "authored_header",
    "batch_count",
    "rows_per_batch",
    "total_rows",
    "batches",
    "root_sha256"
  ],
  "properties": {
    "$schema": { "const": "./schemas/persona-authorship-manifest.schema.json" },
    "schema_version": { "const": 1 },
    "format": { "const": "persona-authorship-manifest-v1" },
    "authored_header": {
      "const": [
        "variant_id",
        "batch_id",
        "category",
        "category_group",
        "topic_id",
        "editorial_role",
        "semantic_group",
        "output_mode",
        "trigger",
        "required_context",
        "tone",
        "interrupt_cost",
        "cooldown_hours",
        "semantic_cooldown_hours",
        "max_per_day",
        "weight",
        "relationship_profile",
        "text",
        "review_status"
      ]
    },
    "batch_count": { "const": 100 },
    "rows_per_batch": { "const": 300 },
    "total_rows": { "const": 30000 },
    "batches": {
      "type": "object",
      "minProperties": 100,
      "maxProperties": 100,
      "patternProperties": {
        "^b(?:00[1-9]|0[1-9][0-9]|100)$": {
          "type": "object",
          "required": ["row_count", "text_sha256", "metadata_sha256"],
          "properties": {
            "row_count": { "const": 300 },
            "text_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "metadata_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "root_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
